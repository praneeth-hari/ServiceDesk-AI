# Copy to .env and fill in. Used by docker-compose.prod.yml.

# Public host name that points at this server (Caddy gets the HTTPS certificate for it)
DOMAIN=helpdesk.example.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Token that the monitoring system (Prometheus) sends as 'Authorization: Bearer <token>'
METRICS_TOKEN=

# Worker processes (rate limits are shared through Redis)
WEB_CONCURRENCY=2

# Optional error tracking (needs sentry-sdk: pip install -r requirements-optional.txt)
SENTRY_DSN=
