# Environment mode (development or production; production enforces a 32+ char non-placeholder SECRET_KEY)
APP_ENV=development

# MySQL 8 connection string
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://helpdesk:helpdesk_password@localhost:3306/helpdesk_db

# Database TLS / SSL verification (for managed MySQL hosts; server certificate is strictly verified)
# DATABASE_SSL_CA=/path/to/ca.pem
# DATABASE_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# MySQL container credentials for Docker Compose
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=helpdesk_db
MYSQL_USER=helpdesk
MYSQL_PASSWORD=helpdesk_password

# JWT Authentication
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Business-Hours SLA Settings
WORK_TIMEZONE=Asia/Kolkata
WORK_DAY_START=09:00
WORK_DAY_END=18:00
WORK_DAYS=[0, 1, 2, 3, 4]

# AI Triage and Duplicate Detection Settings
AI_EMBEDDER=hashing
AI_DUPLICATE_THRESHOLD=0.80
AI_MIN_SIMILARITY=0.12
AI_KNN_K=5
AI_MAX_CANDIDATES=5000

# Optional LLM-Assisted Triage (requires local Ollama server)
# Mode: 'knn' (default, lightweight) or 'llm' (retrieves examples, calls Ollama)
AI_TRIAGE_MODE=knn
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_LLM_MODEL=llama3.1:8b
AI_LLM_TIMEOUT_SECONDS=30
AI_LLM_EXAMPLES=5

# Optional AI Ticket Assist (summary + draft reply; local Ollama only, off by default)
# Mode: 'off' (default) or 'ollama' (enables agent/admin assist endpoints)
AI_ASSIST_MODE=off
AI_ASSIST_MODEL=llama3.1:8b
AI_ASSIST_TIMEOUT_SECONDS=60

# Web UI Distribution Directory
WEB_DIST_DIR=web/dist

# Demo Mode (enables one-click demo logins; NEVER enable in real deployment)
DEMO_MODE=false

# Login Rate Limiting (sliding window for failed password login attempts)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300
